---
import Base from '../layouts/Base.astro';
import Fractal from '../components/Fractal.astro';
import { resources } from '../data/resources';
---

<Base
  title="Stevie Thomas — hitting, swing data, and coaching resources"
  description="Hitting Trainer at Driveline Baseball. Free, technical coaching resources on swing mechanics and bat tracking, built for coaches and players."
>
  <section class="hero-wrap" style="padding: clamp(3rem, 9vw, 6.5rem) 0 0;">
    <Fractal variant="hero" />
    <p class="eyebrow eyebrow--grad reveal" style="--i:0">Hitting Trainer · Driveline Baseball</p>
    <h1 class="reveal" style="--i:1">
      I coach hitters, and I take the swing apart to figure out why it works.
    </h1>
    <p class="lede reveal" style="--i:2">
      Most of my day is in the cage. The rest goes into the question underneath it — what separates a
      swing that finds the ball from one that misses by two inches. I build the tools and write up
      the answers, and I give the coaching ones away.
    </p>
  </section>

  <section style="margin-top: clamp(3.5rem, 9vw, 6rem);">
    <p class="section-label">Free coaching resources</p>
    <p style="color: var(--muted); max-width: 52ch; margin: 0.7rem 0 0;">
      Built to be used in the cage, not just read. No signup, no pitch.
    </p>

    {
      resources.map((r) => (
        <a class="res-card reveal" href={`/resources/${r.slug}/`}>
          <span class="res-card__kind">{r.kind}</span>
          <h2 class="row__title">{r.title}</h2>
          <p>{r.summary}</p>
          <ul class="res-card__tags">
            {r.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </a>
      ))
    }
  </section>

  <section style="margin-top: clamp(3.5rem, 9vw, 6rem);">
    <p class="section-label">Now</p>
    <dl class="now">
      <div>
        <dt>In the cage</dt>
        <dd>
          Building out constrained competitive games for group hitting blocks — same reps, more
          pressure, better transfer.
        </dd>
      </div>
      <div>
        <dt>On the laptop</dt>
        <dd>
          Mapping whiffs in three dimensions from public bat-tracking data, and trying to make the
          model honest about what it doesn't know.
        </dd>
      </div>
      <div>
        <dt>Chewing on</dt>
        <dd>
          Motor learning, variability as a skill rather than a defect, and how much of "feel"
          survives contact with a force plate.
        </dd>
      </div>
    </dl>
  </section>
</Base>

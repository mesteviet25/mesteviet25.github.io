---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Notes — Stevie Thomas" description="Short pieces on hitting, data, and coaching.">
  <section style="padding: clamp(2.5rem, 7vw, 4.5rem) 0 0;">
    <p class="eyebrow reveal" style="--i:0">Index</p>
    <h1 class="reveal" style="--i:1">Notes</h1>
    <p class="lede reveal" style="--i:2">
      Shorter than a project, longer than a tweet. Mostly things I wanted written down before I
      lost the thread.
    </p>
  </section>

  <section style="margin-top: clamp(2.5rem, 7vw, 4rem);">
    {
      notes.length > 0 ? (
        <IndexList
          items={notes.map((n) => ({
            href: `/notes/${n.id}/`,
            title: n.data.title,
            summary: n.data.summary,
            meta: n.data.date.toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
              timeZone: 'UTC',
            }),
          }))}
        />
      ) : (
        <p style="color: var(--muted);">Nothing published yet.</p>
      )
    }
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import Fractal from '../../components/Fractal.astro';
import { metrics, phases, sourceNote } from '../../data/blastMetrics';

// --- Explorer geometry (illustrative teaching model, not a simulator) -------
const P = { x: 320, y: 360 };
const R_BAT = 330;
const R_SWEET = 300;
const TH_START = 140;
const TH_END = -15;
const DEFAULT_TH = 22;

const rad = (d: number) => (d * Math.PI) / 180;
const pt = (r: number, th: number) => ({ x: P.x + r * Math.cos(rad(th)), y: P.y - r * Math.sin(rad(th)) });
const aaOf = (th: number) => Math.max(-8, Math.min(18, 8 + (15 - th) * 0.3));

const tip = pt(R_BAT, DEFAULT_TH);
const sweet = pt(R_SWEET, DEFAULT_TH);
const aa = aaOf(DEFAULT_TH);
const velEnd = { x: sweet.x + 60 * Math.cos(rad(aa)), y: sweet.y - 60 * Math.sin(rad(aa)) };

const trail: string[] = [];
for (let th = TH_START; th >= TH_END; th -= 4) {
  const p = pt(R_SWEET, th);
  trail.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
}
const trailPath = 'M' + trail.join(' L');

const zone = { x: 560, y: 235, w: 95, h: 195 };
const plate = { x: 596, y: 498, w: 66, h: 9 };
const ball = pt(R_SWEET, DEFAULT_TH);
---

<Base
  title="Blast Motion Metrics Primer — Stevie Thomas"
  description="An interactive primer on every Blast Motion metric: what it measures, when in the swing it is captured, its target range, and how the metrics feed each other."
>
  <article>
    <header class="bp-hero hero-wrap">
      <Fractal variant="hero" />
      <p class="eyebrow eyebrow--grad reveal" style="--i:0">Resources · Interactive primer</p>
      <h1 class="reveal" style="--i:1">Blast Motion metrics, from the ground up</h1>
      <p class="lede reveal" style="--i:2">
        A bat sensor does not tell you whether a swing is good. It tells you <em>where</em> the bat was
        and <em>how fast</em> at a few specific instants. This is a map of those instants — what each
        Blast metric measures, exactly when it is captured, the range that tends to work, and how the
        metrics feed each other.
      </p>
      <div class="bp-legend reveal" style="--i:3">
        <span><i class="bp-swatch bp-swatch--b"></i> Key metric</span>
        <span><i class="bp-swatch bp-swatch--a"></i> Supporting metric</span>
        <span>Ranges: HTKC doctrine</span>
      </div>
    </header>

    <section style="margin-top: clamp(1.8rem, 5vw, 2.6rem);">
      <p style="max-width: 58ch; color: var(--muted); margin: 0;">
        Drag the bat through the zone below. As it moves, the metrics that are captured at that
        moment appear — click any of them to read what it measures, when it fires, and what to do
        with it.
      </p>
    </section>

    <!-- ================= Explorer ================= -->
    <section class="bp-layout">
      <div class="bp-stage-wrap">
        <div class="bp-toolbar">
          <span class="bp-toolbar__hint">Drag the bat · ← → to nudge</span>
          <div style="display: flex; gap: 0.5rem;">
            <button class="bp-chip" id="bp-play" type="button">▶ Sweep</button>
            <button class="bp-chip" id="bp-reset" type="button">Reset</button>
          </div>
        </div>

        <div class="bp-stage" id="bp-stage">
          <svg id="bp-svg" viewBox="0 0 900 560" role="img" aria-label="Diagram of a bat sweeping through the strike zone">
            <defs>
              <linearGradient id="bp-bat-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#6d8dff"></stop>
                <stop offset="1" stop-color="#ff5fa2"></stop>
              </linearGradient>
              <marker id="bp-vel-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#ff5fa2"></path>
              </marker>
            </defs>

            <!-- ground + plate -->
            <line x1="40" y1="505" x2="860" y2="505" stroke="currentColor" stroke-width="1.5" opacity="0.5"></line>
            <rect x={plate.x} y={plate.y} width={plate.w} height={plate.h} fill="currentColor" opacity="0.35"></rect>
            <text x={plate.x + plate.w / 2} y="528" text-anchor="middle" fill="currentColor" font-size="11" opacity="0.6" style="font-family: var(--mono)">plate</text>

            <!-- strike zone -->
            <rect x={zone.x} y={zone.y} width={zone.w} height={zone.h} fill="none" stroke="#6d8dff" stroke-width="1.2" stroke-dasharray="5 5" opacity="0.8"></rect>
            <text x={zone.x + zone.w / 2} y={zone.y - 10} text-anchor="middle" fill="#6d8dff" font-size="11" style="font-family: var(--mono)">strike zone</text>

            <!-- hitter -->
            <g fill="none" stroke="currentColor" stroke-linecap="round" opacity="0.4">
              <circle cx="300" cy="220" r="19" stroke-width="3"></circle>
              <path d="M300 239 C292 285 292 312 300 345" stroke-width="3"></path>
              <path d="M300 345 L268 468" stroke-width="4"></path>
              <path d="M300 345 L342 470" stroke-width="4"></path>
              <path d="M304 262 L320 360" stroke-width="3"></path>
            </g>

            <!-- swing-path trail -->
            <path id="bp-trail" d={trailPath} fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" opacity="0.35"></path>

            <!-- live swing-path (drawn from load to current) -->
            <path id="bp-live" d="" fill="none" stroke="url(#bp-bat-grad)" stroke-width="2.4" stroke-linecap="round" opacity="0.9"></path>

            <!-- horizontal guide through sweet spot -->
            <line id="bp-hguide" x1="60" y1={sweet.y} x2={sweet.x} y2={sweet.y} stroke="currentColor" stroke-width="1" stroke-dasharray="3 4" opacity="0.3"></line>

            <!-- velocity arrow (attack direction) -->
            <line id="bp-vel" x1={sweet.x} y1={sweet.y} x2={velEnd.x} y2={velEnd.y} stroke="#ff5fa2" stroke-width="2" marker-end="url(#bp-vel-arrow)"></line>
            <text id="bp-vel-label" x={velEnd.x + 6} y={velEnd.y - 4} fill="#ff5fa2" font-size="11" style="font-family: var(--mono)">attack angle</text>

            <!-- bat -->
            <line id="bp-bat" x1={P.x} y1={P.y} x2={tip.x} y2={tip.y} stroke="url(#bp-bat-grad)" stroke-width="7" stroke-linecap="round"></line>
            <circle cx={P.x} cy={P.y} r="5" fill="currentColor" opacity="0.6"></circle>
            <text x={P.x - 12} y={P.y + 22} text-anchor="end" fill="currentColor" font-size="11" opacity="0.6" style="font-family: var(--mono)">hands</text>

            <!-- draggable handle at the sweet spot -->
            <circle id="bp-handle" cx={sweet.x} cy={sweet.y} r="22" fill="transparent"></circle>
            <circle id="bp-sweet-dot" cx={sweet.x} cy={sweet.y} r="6" fill="#ff5fa2"></circle>
            <circle id="bp-sweet-ring" cx={sweet.x} cy={sweet.y} r="11" fill="none" stroke="#ff5fa2" stroke-width="1.5" opacity="0.7"></circle>

            <!-- ball sits on top of everything, only during contact -->
            <g id="bp-ball" opacity="0">
              <circle cx={ball.x} cy={ball.y} r="12" fill="none" stroke="#ff5fa2" stroke-width="1" opacity="0.5"></circle>
              <circle cx={ball.x} cy={ball.y} r="8" fill="#fbfbfd" stroke="#ff5fa2" stroke-width="2"></circle>
            </g>
          </svg>

          <div class="bp-popup" id="bp-popup">
            <span class="bp-popup__phase" id="bp-popup-phase">Contact</span>
            <div id="bp-popup-chips"></div>
          </div>
        </div>

        <dl class="bp-readout">
          <div>
            <dt>Phase</dt>
            <dd id="bp-r-phase">Contact</dd>
          </div>
          <div>
            <dt>Attack angle</dt>
            <dd><span id="bp-r-aa">{aa.toFixed(0)}</span><small>°</small></dd>
          </div>
          <div>
            <dt>Bat vs ground</dt>
            <dd><span id="bp-r-vba">{DEFAULT_TH.toFixed(0)}</span><small>°</small></dd>
          </div>
          <div>
            <dt>Contact depth</dt>
            <dd id="bp-r-depth" style="font-size: 0.82rem;">Middle</dd>
          </div>
        </dl>

        <div class="bp-timeline">
          <div class="bp-track" id="bp-track">
            {
              phases.map((p) => (
                <button class="bp-seg" type="button" data-phase={p.id}>
                  {p.short}
                  <span class={`bp-seg__dot${p.metricIds.length ? '' : ' bp-seg__dot--none'}`} />
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- ================= Detail drawer ================= -->
      <aside class="bp-drawer" id="bp-drawer" aria-live="polite"></aside>
    </section>

    <p class="bp-source" style="margin-top: 1.4rem;">
      The explorer is a teaching drawing: the geometry is illustrative, not a physical simulation.
      The target ranges and benchmarks below are the real ones.
    </p>

    <!-- ================= Relationship map ================= -->
    <section style="margin-top: clamp(3rem, 8vw, 4.5rem);">
      <p class="section-label">How the metrics feed each other</p>
      <h2>The chain is the story</h2>
      <p style="max-width: 58ch; color: var(--muted);">
        Blast metrics are not a checklist. Connection at the start of the downswing sets up
        connection at impact, which sets up on-plane efficiency. Bat speed is built upstream by
        rotational acceleration and the hands. Click a node to open it.
      </p>

      <div class="bp-map-wrap">
        <svg class="bp-map" viewBox="0 0 900 500" role="img" aria-label="Relationship map of Blast metrics">
          <defs>
            <marker id="bp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor"></path>
            </marker>
          </defs>

          {[
            { id: 'early-connection', x: 40, y: 60 },
            { id: 'rotational-acceleration', x: 40, y: 185 },
            { id: 'peak-hand-speed', x: 40, y: 310 },
            { id: 'time-to-contact', x: 40, y: 435 },
            { id: 'connection-at-impact', x: 355, y: 60 },
            { id: 'bat-speed', x: 355, y: 250 },
            { id: 'on-plane-efficiency', x: 670, y: 60 },
            { id: 'power', x: 670, y: 250 },
          ].map((n) => {
            const m = metrics.find((x) => x.id === n.id)!;
            return (
              <g class="bp-node" data-metric={n.id} tabindex="0" role="button" aria-label={m.name} transform={`translate(${n.x},${n.y})`}>
                <rect width="190" height="46" rx="3"></rect>
                <text x="14" y="28" fill="currentColor">{m.name}</text>
              </g>
            );
          })}

          <!-- edges -->
          <path class="bp-edge bp-edge--chain" d="M230 83 L355 83"></path>
          <path class="bp-edge bp-edge--chain" d="M545 83 L670 83"></path>
          <path class="bp-edge" d="M230 208 L355 268"></path>
          <path class="bp-edge" d="M230 333 L355 288"></path>
          <path class="bp-edge" d="M230 458 L355 285"></path>
          <path class="bp-edge" d="M545 273 L670 273"></path>

          <text class="bp-edge-label" x="235" y="74">sets up</text>
          <text class="bp-edge-label" x="550" y="74">downstream of both</text>
          <text class="bp-edge-label" x="238" y="196">builds</text>
          <text class="bp-edge-label" x="238" y="348">builds</text>
          <text class="bp-edge-label" x="238" y="452">longer = less</text>
          <text class="bp-edge-label" x="560" y="264">derives</text>
        </svg>
      </div>
    </section>

    <!-- ================= Reference tables ================= -->
    <section class="bp-tables">
      <p class="section-label">Reference</p>
      <h2>Target ranges at a glance</h2>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>When</th>
            <th>Target</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((m) => (
              <tr>
                <td>
                  {m.key && <span class="bp-flag">★ </span>}
                  {m.name}
                </td>
                <td style="color: var(--muted);">{m.when}</td>
                <td>{m.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 style="margin-top: 2.6rem;">Level benchmarks</h2>
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>Bat speed (mean)</th>
            <th>Rotational acceleration</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>MLB</td><td>~75+ mph</td><td>~17 g</td></tr>
          <tr><td>NPB</td><td>~70–75 mph</td><td>~13–16 g</td></tr>
          <tr><td>MiLB</td><td>~72–76 mph</td><td>~14–17 g</td></tr>
          <tr><td>College</td><td>~68–74 mph</td><td>~12–13 g</td></tr>
          <tr><td>High school</td><td>~60–66 mph</td><td>&lt; 10 g</td></tr>
        </tbody>
      </table>
      <p style="color: var(--muted); font-size: 0.84rem; margin-top: 0.8rem;">
        Directional. Driveline models level-specific regressions; confirm the athlete's level before
        grading against any number here.
      </p>
    </section>

    <p class="bp-source">{sourceNote}</p>
  </article>

  <script is:inline type="application/json" id="bp-metrics" set:html={JSON.stringify(metrics)}></script>
  <script is:inline type="application/json" id="bp-phases" set:html={JSON.stringify(phases)}></script>

  <script>
    const METRICS = JSON.parse(document.getElementById('bp-metrics').textContent);
    const PHASES = JSON.parse(document.getElementById('bp-phases').textContent);
    const byId = (id) => METRICS.find((m) => m.id === id);

    const P = { x: 320, y: 360 };
    const R_BAT = 330;
    const R_SWEET = 300;
    const TH_START = 140;
    const TH_END = -15;
    const DEFAULT_TH = 22;

    const rad = (d) => (d * Math.PI) / 180;
    const pt = (r, th) => ({ x: P.x + r * Math.cos(rad(th)), y: P.y - r * Math.sin(rad(th)) });
    const aaOf = (th) => Math.max(-8, Math.min(18, 8 + (15 - th) * 0.3));

    const phaseFor = (th) => {
      if (th > 115) return 'load';
      if (th > 95) return 'downswing-start';
      if (th > 55) return 'acceleration';
      if (th > 30) return 'mid-swing';
      if (th > 5) return 'contact';
      return 'finish';
    };

    const el = {
      stage: document.getElementById('bp-stage'),
      svg: document.getElementById('bp-svg'),
      bat: document.getElementById('bp-bat'),
      sweetDot: document.getElementById('bp-sweet-dot'),
      sweetRing: document.getElementById('bp-sweet-ring'),
      handle: document.getElementById('bp-handle'),
      live: document.getElementById('bp-live'),
      hguide: document.getElementById('bp-hguide'),
      ball: document.getElementById('bp-ball'),
      vel: document.getElementById('bp-vel'),
      velLabel: document.getElementById('bp-vel-label'),
      popup: document.getElementById('bp-popup'),
      popupPhase: document.getElementById('bp-popup-phase'),
      popupChips: document.getElementById('bp-popup-chips'),
      rPhase: document.getElementById('bp-r-phase'),
      rAa: document.getElementById('bp-r-aa'),
      rVba: document.getElementById('bp-r-vba'),
      rDepth: document.getElementById('bp-r-depth'),
      track: document.getElementById('bp-track'),
      drawer: document.getElementById('bp-drawer'),
      play: document.getElementById('bp-play'),
      reset: document.getElementById('bp-reset'),
    };

    let theta = DEFAULT_TH;
    let selected = 'bat-speed';
    let playing = false;
    let raf = null;

    const phaseLabel = (id) => PHASES.find((p) => p.id === id).label;

    function depthWord(x) {
      // plate front edge at 596; further right = more out front
      const d = x - 596;
      if (d > 24) return 'Out front';
      if (d > -12) return 'Middle';
      return 'Deep';
    }

    function setTheta(th) {
      theta = Math.max(TH_END, Math.min(TH_START, th));
      const p = pt(R_SWEET, theta);
      const t = pt(R_BAT, theta);
      const a = aaOf(theta);
      const v = { x: p.x + 60 * Math.cos(rad(a)), y: p.y - 60 * Math.sin(rad(a)) };

      el.bat.setAttribute('x2', t.x);
      el.bat.setAttribute('y2', t.y);
      el.sweetDot.setAttribute('cx', p.x);
      el.sweetDot.setAttribute('cy', p.y);
      el.sweetRing.setAttribute('cx', p.x);
      el.sweetRing.setAttribute('cy', p.y);
      el.handle.setAttribute('cx', p.x);
      el.handle.setAttribute('cy', p.y);
      el.hguide.setAttribute('y1', p.y);
      el.hguide.setAttribute('y2', p.y);
      el.hguide.setAttribute('x2', p.x);
      el.ball.querySelectorAll('circle').forEach((c) => {
        c.setAttribute('cx', p.x);
        c.setAttribute('cy', p.y);
      });
      el.vel.setAttribute('x1', p.x);
      el.vel.setAttribute('y1', p.y);
      el.vel.setAttribute('x2', v.x);
      el.vel.setAttribute('y2', v.y);
      el.velLabel.setAttribute('x', v.x + 6);
      el.velLabel.setAttribute('y', v.y - 4);

      // live traveled arc, from load to current
      const livePts = [];
      for (let s = TH_START; s >= theta; s -= 4) {
        const q = pt(R_SWEET, s);
        livePts.push(`${q.x.toFixed(1)},${q.y.toFixed(1)}`);
      }
      const last = pt(R_SWEET, theta);
      livePts.push(`${last.x.toFixed(1)},${last.y.toFixed(1)}`);
      el.live.setAttribute('d', livePts.length > 1 ? 'M' + livePts.join(' L') : '');

      const phase = phaseFor(theta);
      el.rPhase.textContent = phaseLabel(phase);
      el.rAa.textContent = a.toFixed(0);
      el.rVba.textContent = Math.abs(theta).toFixed(0);
      el.rDepth.textContent = depthWord(p.x);

      const showBall = phase === 'contact';
      el.ball.setAttribute('opacity', showBall ? '1' : '0');
      el.vel.setAttribute('opacity', phase === 'finish' ? '0.35' : '1');
      el.velLabel.setAttribute('opacity', phase === 'finish' ? '0' : '1');

      // popup
      el.popupPhase.textContent = phaseLabel(phase);
      const ids = PHASES.find((x) => x.id === phase).metricIds;
      el.popupChips.innerHTML = ids.length
        ? ids
            .map((id) => {
              const m = byId(id);
              const star = m.key ? ' bp-chip--key' : '';
              const active = id === selected ? ' is-active' : '';
              return `<button class="bp-chip${star}${active}" data-metric="${id}" type="button">${m.name}${m.unit ? ' · ' + m.unit : ''}</button>`;
            })
            .join('')
        : '<span style="font-family: var(--mono); font-size: 0.6rem; color: var(--muted); padding: 0.3rem;">No Blast metric fires here.</span>';

      const leftPct = Math.max(14, Math.min(86, (p.x / 900) * 100));
      const topPct = Math.max(42, Math.min(92, (p.y / 560) * 100));
      el.popup.style.left = leftPct + '%';
      el.popup.style.top = topPct + '%';
      // flip below the bat when the sweet spot rides high, so the box never clips
      const below = p.y / 560 < 0.5;
      el.popup.style.transform = below ? 'translate(-50%, 16%)' : 'translate(-50%, -114%)';
      el.popup.classList.toggle('is-below', below);

      // timeline active
      [...el.track.children].forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-phase') === phase);
      });
    }

    function renderDrawer(id) {
      const m = byId(id);
      if (!m) return;
      const levels = m.levels
        ? `<dt>Levels</dt><dd>${m.levels.map((l) => `${l.label}: ${l.value}`).join('<br>')}</dd>`
        : '';
      const flags = m.flags.length
        ? `<dt>Watch for</dt><dd><ul style="margin:0; padding-left: 1rem;">${m.flags
            .map((f) => `<li>${f}</li>`)
            .join('')}</ul></dd>`
        : '';
      const related = m.related.length
        ? `<ul class="bp-related">${m.related
            .map((r) => `<li><button class="bp-chip" data-metric="${r}" type="button">${byId(r).name}</button></li>`)
            .join('')}</ul>`
        : '';

      el.drawer.innerHTML = `
        <p class="bp-drawer__phase">${m.key ? '★ Key metric' : 'Supporting metric'}</p>
        <h3>${m.name}${m.unit ? ` <span style="color: var(--muted); font-weight: 400; font-size: 1rem;">${m.unit}</span>` : ''}</h3>
        <dl class="bp-spec">
          <dt>When measured</dt><dd>${m.when}</dd>
          <dt>What it is</dt><dd>${m.definition}</dd>
          <dt>Why it matters</dt><dd>${m.why}</dd>
          <dt>Target</dt><dd><strong>${m.target}</strong></dd>
          ${m.inGym ? `<dt>In-gym pro</dt><dd>${m.inGym}</dd>` : ''}
          ${m.mlb ? `<dt>MLB</dt><dd>${m.mlb}</dd>` : ''}
          ${levels}
          ${flags}
        </dl>
        ${related ? `<p style="font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 1.3rem 0 0;">Related</p>${related}` : ''}
      `;
    }

    function selectMetric(id) {
      selected = id;
      renderDrawer(id);
      el.popupChips.querySelectorAll('[data-metric]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-metric') === id);
      });
      document.querySelectorAll('.bp-map .bp-node').forEach((n) => {
        n.classList.toggle('is-active', n.getAttribute('data-metric') === id);
      });
      if (window.matchMedia('(max-width: 60rem)').matches) {
        el.drawer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // ---- drag: anywhere on the diagram moves the bat ----
    let dragging = false;
    function svgAngle(evt) {
      const ctm = el.svg.getScreenCTM().inverse();
      const p = new DOMPoint(evt.clientX, evt.clientY).matrixTransform(ctm);
      return (Math.atan2(P.y - p.y, p.x - P.x) * 180) / Math.PI;
    }
    el.svg.style.cursor = 'grab';
    el.svg.addEventListener('pointerdown', (e) => {
      dragging = true;
      stopPlay();
      el.svg.setPointerCapture(e.pointerId);
      el.svg.style.cursor = 'grabbing';
      setTheta(svgAngle(e));
    });
    el.svg.addEventListener('pointermove', (e) => {
      if (dragging) setTheta(svgAngle(e));
    });
    const endDrag = (e) => {
      if (!dragging) return;
      dragging = false;
      el.svg.style.cursor = 'grab';
      try {
        el.svg.releasePointerCapture(e.pointerId);
      } catch (err) {
        /* pointer already released */
      }
    };
    el.svg.addEventListener('pointerup', endDrag);
    el.svg.addEventListener('pointercancel', endDrag);

    // keyboard nudge
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') setTheta(theta + 3);
      if (e.key === 'ArrowRight') setTheta(theta - 3);
    });

    // ---- play ----
    function stopPlay() {
      playing = false;
      if (raf) cancelAnimationFrame(raf);
      raf = null;
      el.play.textContent = '▶ Sweep';
    }
    function tick() {
      let th = theta - 1.6;
      if (th <= TH_END) {
        setTheta(TH_END);
        stopPlay();
        return;
      }
      setTheta(th);
      raf = requestAnimationFrame(tick);
    }
    el.play.addEventListener('click', () => {
      if (playing) {
        stopPlay();
        return;
      }
      playing = true;
      el.play.textContent = '❚❚ Pause';
      setTheta(TH_START);
      raf = requestAnimationFrame(tick);
    });
    el.reset.addEventListener('click', () => {
      stopPlay();
      setTheta(DEFAULT_TH);
      selectMetric('bat-speed');
    });

    // ---- timeline ----
    el.track.addEventListener('click', (e) => {
      const b = e.target.closest('[data-phase]');
      if (!b) return;
      stopPlay();
      const mid = {
        load: 128,
        'downswing-start': 105,
        acceleration: 75,
        'mid-swing': 42,
        contact: 17,
        finish: -5,
      };
      setTheta(mid[b.getAttribute('data-phase')]);
    });

    // ---- chips + map nodes (delegated) ----
    document.addEventListener('click', (e) => {
      const t = e.target.closest('[data-metric]');
      if (t) selectMetric(t.getAttribute('data-metric'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const n = document.activeElement;
      if (n && n.classList && n.classList.contains('bp-node')) {
        e.preventDefault();
        selectMetric(n.getAttribute('data-metric'));
      }
    });

    // init
    setTheta(DEFAULT_TH);
    selectMetric(selected);
  </script>
</Base>

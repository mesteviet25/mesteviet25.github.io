---
import Base from '../../layouts/Base.astro';
import Fractal from '../../components/Fractal.astro';
import { metrics, sourceNote } from '../../data/blastMetrics';
import swingData from '../../data/averageSwing.json';

const nSwings = swingData.meta.n_swings;
---

<Base
  title="Blast Motion Metrics Primer — Stevie Thomas"
  description="An interactive 3D primer on every Blast Motion metric, built from the average swing in Driveline's biomechanics lab: what each metric measures, when it is captured, and how they feed each other."
>
  <article>
    <header class="bp-hero hero-wrap">
      <Fractal variant="hero" />
      <p class="eyebrow eyebrow--grad reveal" style="--i:0">Resources · Interactive primer</p>
      <h1 class="reveal" style="--i:1">Blast Motion metrics, from the ground up</h1>
      <p class="lede reveal" style="--i:2">
        A bat sensor does not tell you whether a swing is good. It tells you <em>where</em> the bat was
        and <em>how fast</em> at a few specific instants. The bat below is the <strong>average swing</strong>
        from Driveline's biomechanics lab — {nSwings} clean right-handed swings, real bat motion through
        space. Drag to orbit it; scrub the swing and it pauses at each metric.
      </p>
    </header>

    <!-- ================= Full-page 3D explorer ================= -->
    <section class="bp-bleed bp-explorer" id="bp-explorer">
      <div class="bp-frame" id="bp-frame">
        <div class="bp-toolbar">
          <div class="bp-toolbar__group">
            <button class="bp-btn" id="bp-prev" type="button" aria-label="Previous checkpoint">‹</button>
            <button class="bp-btn bp-btn--play" id="bp-play" type="button">▶ Swing</button>
            <button class="bp-btn" id="bp-next" type="button" aria-label="Next checkpoint">›</button>
          </div>
          <span class="bp-toolbar__hint">Drag to orbit · scroll to zoom</span>
        </div>

        <canvas id="bp-canvas" class="bp-canvas" aria-label="3D rendering of the average lab swing"></canvas>
        <canvas id="bp-overlay" class="bp-overlay"></canvas>
        <div class="bp-callouts" id="bp-callouts"></div>

        <div class="bp-hud">
          <div class="bp-hud__text">
            <span class="bp-hud__stop" id="bp-stop">Downswing start</span>
            <span class="bp-hud__blurb" id="bp-blurb"></span>
          </div>
          <span class="bp-hud__cta" id="bp-cta">Click a box to read more</span>
        </div>
        <div class="bp-progress"><span id="bp-progress-fill"></span></div>
      </div>

      <div class="bp-timeline">
        <div class="bp-track" id="bp-track"></div>
        <p class="bp-timeline__caption">
          Average swing · {nSwings} swings · barrel tip ≈ {swingData.bat_speed_mph} mph near contact ·
          contact at the strike zone. Bat motion is real; the zone is illustrative.
        </p>
      </div>
    </section>

    <!-- ================= Relationship map ================= -->
    <section style="margin-top: clamp(3rem, 8vw, 4.5rem);">
      <p class="section-label">How the metrics feed each other</p>
      <h2>The chain is the story</h2>
      <p style="max-width: 58ch; color: var(--muted);">
        Blast metrics are not a checklist. Connection at the start of the downswing sets up
        connection at impact, which sets up on-plane efficiency. Bat speed is built upstream by
        rotational acceleration and the hands. Click a node to open it.
      </p>

      <div class="bp-map-wrap">
        <svg class="bp-map" viewBox="0 0 900 500" role="img" aria-label="Relationship map of Blast metrics">
          <defs>
            <marker id="bp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor"></path>
            </marker>
          </defs>

          {[
            { id: 'early-connection', x: 40, y: 60 },
            { id: 'rotational-acceleration', x: 40, y: 185 },
            { id: 'peak-hand-speed', x: 40, y: 310 },
            { id: 'time-to-contact', x: 40, y: 435 },
            { id: 'connection-at-impact', x: 355, y: 60 },
            { id: 'bat-speed', x: 355, y: 250 },
            { id: 'on-plane-efficiency', x: 670, y: 60 },
            { id: 'power', x: 670, y: 250 },
          ].map((n) => {
            const m = metrics.find((x) => x.id === n.id)!;
            return (
              <g class="bp-node" data-metric={n.id} tabindex="0" role="button" aria-label={m.name} transform={`translate(${n.x},${n.y})`}>
                <rect width="190" height="46" rx="3"></rect>
                <text x="14" y="28" fill="currentColor">{m.name}</text>
              </g>
            );
          })}

          <path class="bp-edge bp-edge--chain" d="M230 83 L355 83"></path>
          <path class="bp-edge bp-edge--chain" d="M545 83 L670 83"></path>
          <path class="bp-edge" d="M230 208 L355 268"></path>
          <path class="bp-edge" d="M230 333 L355 288"></path>
          <path class="bp-edge" d="M230 458 L355 285"></path>
          <path class="bp-edge" d="M545 273 L670 273"></path>

          <text class="bp-edge-label" x="235" y="74">sets up</text>
          <text class="bp-edge-label" x="550" y="74">downstream of both</text>
          <text class="bp-edge-label" x="238" y="196">builds</text>
          <text class="bp-edge-label" x="238" y="348">builds</text>
          <text class="bp-edge-label" x="238" y="452">longer = less</text>
          <text class="bp-edge-label" x="560" y="264">derives</text>
        </svg>
      </div>
    </section>

    <!-- ================= Reference tables ================= -->
    <section class="bp-tables">
      <p class="section-label">Reference</p>
      <h2>Target ranges at a glance</h2>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>When</th>
            <th>Target</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((m) => (
              <tr>
                <td>
                  {m.key && <span class="bp-flag">★ </span>}
                  {m.name}
                </td>
                <td style="color: var(--muted);">{m.when}</td>
                <td>{m.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 style="margin-top: 2.6rem;">Level benchmarks</h2>
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>Bat speed (mean)</th>
            <th>Rotational acceleration</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>MLB</td><td>~75+ mph</td><td>~17 g</td></tr>
          <tr><td>NPB</td><td>~70–75 mph</td><td>~13–16 g</td></tr>
          <tr><td>MiLB</td><td>~72–76 mph</td><td>~14–17 g</td></tr>
          <tr><td>College</td><td>~68–74 mph</td><td>~12–13 g</td></tr>
          <tr><td>High school</td><td>~60–66 mph</td><td>&lt; 10 g</td></tr>
        </tbody>
      </table>
      <p style="color: var(--muted); font-size: 0.84rem; margin-top: 0.8rem;">
        Directional. Driveline models level-specific regressions; confirm the athlete's level before
        grading against any number here.
      </p>
    </section>

    <p class="bp-source">{sourceNote}</p>
  </article>

  <!-- ================= Slide-over panel ================= -->
  <div class="bp-scrim" id="bp-scrim" hidden></div>
  <aside class="bp-panel" id="bp-panel" aria-hidden="true" aria-label="Metric detail">
    <button class="bp-panel__close" id="bp-panel-close" type="button" aria-label="Close">×</button>
    <div id="bp-panel-body"></div>
  </aside>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
    import { metrics } from '../../data/blastMetrics';
    import data from '../../data/averageSwing.json';

    const byId = (id) => metrics.find((m) => m.id === id);

    const T = data.t_ms;
    const O = data.origin;
    const D = data.distal;
    const S = data.sweet;
    const CI = data.contact_index;
    const GROUND = -data.contact_height_m;
    const PLANE = data.plane;

    const V = (p) => new THREE.Vector3(p[0], p[1], p[2]);

    const idxForT = (t) => {
      let best = 0, bd = Infinity;
      T.forEach((v, i) => { const d = Math.abs(v - t); if (d < bd) { bd = d; best = i; } });
      return best;
    };

    const STOPS = [
      { key: 'load', label: 'Load', t: -430, ids: [], blurb: 'Coil back into the rear hip. No Blast metric fires yet — load and stance are mostly style.' },
      { key: 'early-connection', label: 'Downswing start', t: -330, ids: ['early-connection'], blurb: 'Early Connection is captured the moment the bat transitions from load into rotation.' },
      { key: 'rotational-acceleration', label: 'Acceleration', t: -255, ids: ['rotational-acceleration'], win: [-390, -150], blurb: 'Rotational Acceleration covers the bat transitioning from load into rotation, until roughly the back elbow slots.' },
      { key: 'peak-hand-speed', label: 'Through the zone', t: -130, ids: ['peak-hand-speed'], blurb: 'Peak Hand Speed is the fastest the handle moves — measured six inches off the knob.' },
      { key: 'on-plane-efficiency', label: 'On plane', t: -70, ids: ['on-plane-efficiency'], win: [-170, -10], blurb: 'On-Plane Efficiency is the share of the swing the barrel spends on the plane set by the vertical bat angle at contact.' },
      { key: 'contact', label: 'Contact', t: 0, ids: ['bat-speed', 'attack-angle', 'vertical-bat-angle', 'connection-at-impact'], blurb: 'At contact, Blast captures bat speed, attack angle, vertical bat angle, and connection at impact.' },
      { key: 'finish', label: 'Finish', t: 120, ids: [], blurb: 'Follow-through and deceleration.' },
    ];

    const ANCHOR = {
      'early-connection': { kind: 'hands', dx: -300, dy: -150 },
      'rotational-acceleration': { kind: 'window', dx: -240, dy: -170 },
      'peak-hand-speed': { kind: 'knob', dx: -300, dy: 120 },
      'on-plane-efficiency': { kind: 'window', dx: 170, dy: 170 },
      'bat-speed': { kind: 'sweet', dx: 210, dy: -150 },
      'attack-angle': { kind: 'barrel', dx: 280, dy: -40 },
      'vertical-bat-angle': { kind: 'barrel', dx: 280, dy: 90 },
      'connection-at-impact': { kind: 'hands', dx: -40, dy: 210 },
    };

    const el = {
      canvas: document.getElementById('bp-canvas'),
      overlay: document.getElementById('bp-overlay'),
      callouts: document.getElementById('bp-callouts'),
      stop: document.getElementById('bp-stop'),
      blurb: document.getElementById('bp-blurb'),
      progress: document.getElementById('bp-progress-fill'),
      play: document.getElementById('bp-play'),
      track: document.getElementById('bp-track'),
      panel: document.getElementById('bp-panel'),
      panelBody: document.getElementById('bp-panel-body'),
      scrim: document.getElementById('bp-scrim'),
    };
    const octx = el.overlay.getContext('2d');

    // ---- scene ----
    const renderer = new THREE.WebGLRenderer({ canvas: el.canvas, antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, 1, 0.01, 100);
    camera.up.set(0, 0, 1);

    const centroid = (arr) => [0, 1, 2].map((a) => arr.reduce((s, p) => s + p[a], 0) / arr.length);
    const allPts = [...D, ...O];
    const target = centroid(allPts);
    let RAD = 0;
    for (const p of allPts) RAD = Math.max(RAD, V(p).distanceTo(V(target)));
    const camDist = (RAD / Math.tan((camera.fov * Math.PI) / 360)) * 1.05;
    const controls = new OrbitControls(camera, el.canvas);
    controls.target.copy(V(target));
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.minDistance = RAD * 0.8;
    controls.maxDistance = RAD * 7;
    controls.enablePan = false;
    camera.position.copy(V(target).add(new THREE.Vector3(-0.85, -1.0, 0.62).normalize().multiplyScalar(camDist)));

    scene.add(new THREE.HemisphereLight(0xffffff, 0x1a1f33, 1.15));
    const dir = new THREE.DirectionalLight(0xffffff, 1.1);
    dir.position.set(-1.4, -1.8, 2.2);
    scene.add(dir);
    scene.add(new THREE.AmbientLight(0xffffff, 0.25));

    // ground grid
    const grid = new THREE.GridHelper(3, 15, 0x3a4260, 0x262c40);
    grid.rotation.x = Math.PI / 2;
    grid.position.set(target[0], target[1], GROUND);
    grid.material.transparent = true;
    grid.material.opacity = 0.55;
    scene.add(grid);

    // strike zone (illustrative box near contact)
    const zoneGeo = new THREE.BoxGeometry(0.26, 0.44, 0.6);
    const zone = new THREE.LineSegments(
      new THREE.EdgesGeometry(zoneGeo),
      new THREE.LineBasicMaterial({ color: 0x6d8dff, transparent: true, opacity: 0.85 })
    );
    zone.position.set(-0.06, 0, 0.0);
    scene.add(zone);

    // swing plane, bounded to the downswing path
    (() => {
      const n = V(PLANE.normal);
      const u = V(PLANE.u);
      const v = new THREE.Vector3().crossVectors(n, u).normalize();
      const c = V(PLANE.center);
      let aMin = Infinity, aMax = -Infinity, bMin = Infinity, bMax = -Infinity;
      for (const p of D) {
        const pp = V(p).sub(c);
        const a = pp.dot(u), b = pp.dot(v);
        aMin = Math.min(aMin, a); aMax = Math.max(aMax, a);
        bMin = Math.min(bMin, b); bMax = Math.max(bMax, b);
      }
      const plane = new THREE.Mesh(
        new THREE.PlaneGeometry(aMax - aMin, bMax - bMin),
        new THREE.MeshBasicMaterial({ color: 0x6d8dff, transparent: true, opacity: 0.06, side: THREE.DoubleSide, depthWrite: false })
      );
      const basis = new THREE.Matrix4().makeBasis(u, v, n);
      plane.quaternion.setFromRotationMatrix(basis);
      plane.position.copy(c).add(u.clone().multiplyScalar((aMin + aMax) / 2)).add(v.clone().multiplyScalar((bMin + bMax) / 2));
      scene.add(plane);
    })();

    // hands path (dashed)
    const handsLine = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(O.map(V)),
      new THREE.LineDashedMaterial({ color: 0x8d96ad, dashSize: 0.03, gapSize: 0.03, transparent: true, opacity: 0.6 })
    );
    handsLine.computeLineDistances();
    scene.add(handsLine);

    // barrel path (gradient tube) — traced through the sweet spot, 6" in from the tip
    const curve = new THREE.CatmullRomCurve3(S.map(V));
    const tube = new THREE.TubeGeometry(curve, 260, 0.011, 10, false);
    {
      const cA = new THREE.Color(0x6d8dff);
      const cB = new THREE.Color(0xff5fa2);
      const uv = tube.attributes.uv;
      const pos = tube.attributes.position;
      const colors = [];
      const tmp = new THREE.Color();
      for (let i = 0; i < pos.count; i++) {
        tmp.copy(cA).lerp(cB, uv.getX(i));
        colors.push(tmp.r, tmp.g, tmp.b);
      }
      tube.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
    }
    scene.add(new THREE.Mesh(tube, new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.45, metalness: 0.1, emissive: 0x140a1e, emissiveIntensity: 0.6 })));

    // contact marker
    const contact = new THREE.Mesh(
      new THREE.TorusGeometry(0.035, 0.005, 8, 24),
      new THREE.MeshBasicMaterial({ color: 0xeaeefb, transparent: true, opacity: 0.8 })
    );
    scene.add(contact);

    // bat
    const batLen = V(D[CI]).distanceTo(V(O[CI]));
    const batGeo = new THREE.CylinderGeometry(0.03, 0.012, batLen, 14, 1);
    batGeo.rotateX(Math.PI / 2);
    batGeo.translate(0, 0, batLen / 2);
    {
      const cA = new THREE.Color(0x9db4ff);
      const cB = new THREE.Color(0xff5fa2);
      const pos = batGeo.attributes.position;
      const colors = [];
      const tmp = new THREE.Color();
      for (let i = 0; i < pos.count; i++) {
        const t = Math.max(0, Math.min(1, pos.getZ(i) / batLen));
        tmp.copy(cA).lerp(cB, t);
        colors.push(tmp.r, tmp.g, tmp.b);
      }
      batGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
    }
    const bat = new THREE.Mesh(batGeo, new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.4, metalness: 0.15 }));
    scene.add(bat);
    const knob = new THREE.Mesh(new THREE.SphereGeometry(0.022, 12, 12), new THREE.MeshStandardMaterial({ color: 0x2c3350 }));
    scene.add(knob);
    const sweet = new THREE.Mesh(new THREE.SphereGeometry(0.019, 12, 12), new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xff5fa2, emissiveIntensity: 0.4 }));
    scene.add(sweet);

    const ZAXIS = new THREE.Vector3(0, 0, 1);
    let idx = idxForT(-330);

    function updateBat() {
      const o = V(O[idx]), d = V(D[idx]);
      const dirv = d.clone().sub(o);
      const q = new THREE.Quaternion().setFromUnitVectors(ZAXIS, dirv.clone().normalize());
      bat.quaternion.copy(q);
      bat.position.copy(o);
      knob.position.copy(o);
      sweet.position.copy(V(S[idx]));
    }

    // ---- sizing ----
    let cw = 1, ch = 1;
    function resize() {
      const r = el.canvas.getBoundingClientRect();
      cw = r.width; ch = r.height;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      renderer.setPixelRatio(dpr);
      renderer.setSize(cw, ch, false);
      camera.aspect = cw / Math.max(1, ch);
      camera.updateProjectionMatrix();
      el.overlay.width = Math.round(cw * dpr);
      el.overlay.height = Math.round(ch * dpr);
      el.overlay.style.width = cw + 'px';
      el.overlay.style.height = ch + 'px';
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ---- callouts ----
    const projected = [];
    function anchor3(kind, stop) {
      if (kind === 'hands') return O[idx];
      if (kind === 'knob') return [0, 1, 2].map((a) => O[idx][a] + 0.17 * (D[idx][a] - O[idx][a]));
      if (kind === 'window') return S[idxForT((stop.win[0] + stop.win[1]) / 2)];
      return S[idx];
    }
    function project3(p) {
      const v = V(p).project(camera);
      return { x: (v.x * 0.5 + 0.5) * cw, y: (-v.y * 0.5 + 0.5) * ch, z: v.z };
    }

    function renderCallouts(stop) {
      const CW = 200, CH = 52;
      el.callouts.textContent = '';
      projected.length = 0;
      for (const id of stop.ids) {
        const m = byId(id);
        const spec = ANCHOR[id];
        if (!m || !spec) continue;
        const s = project3(anchor3(spec.kind, stop));
        let bx = Math.max(10, Math.min(cw - CW - 10, s.x + spec.dx));
        let by = Math.max(10, Math.min(ch - CH - 10, s.y + spec.dy));
        projected.push({ s, box: { x: bx + CW / 2, y: by + CH / 2 } });
        const box = document.createElement('button');
        box.className = 'bp-callout';
        box.type = 'button';
        box.dataset.metric = id;
        box.style.left = bx + 'px';
        box.style.top = by + 'px';
        box.innerHTML = `<span class="bp-callout__title">${m.key ? '★ ' : ''}${m.name}</span><span class="bp-callout__sub">${stop.label}${m.unit ? ' · ' + m.unit : ''}</span>`;
        el.callouts.appendChild(box);
      }
    }

    function drawOverlay() {
      octx.clearRect(0, 0, cw, ch);
      octx.strokeStyle = 'rgba(141,150,173,0.75)';
      octx.fillStyle = '#ff5fa2';
      octx.lineWidth = 1;
      for (const { s, box } of projected) {
        octx.beginPath();
        octx.moveTo(s.x, s.y);
        octx.lineTo(box.x, box.y);
        octx.stroke();
        octx.beginPath();
        octx.arc(s.x, s.y, 3.5, 0, Math.PI * 2);
        octx.fill();
      }
    }

    function nearestStop() {
      const t = T[idx];
      let best = 0, bd = Infinity;
      STOPS.forEach((s, i) => { const d = Math.abs(s.t - t); if (d < bd) { bd = d; best = i; } });
      return best;
    }

    // ---- animation loop ----
    let playing = false, targetIdx = 0, holdUntil = 0;
    function stopPlay() { playing = false; el.play.textContent = '▶ Swing'; }

    function frame(ts) {
      requestAnimationFrame(frame);
      if (playing) {
        if (!holdUntil || ts >= holdUntil) {
          const goal = idxForT(STOPS[targetIdx].t);
          const diff = goal - idx;
          if (Math.abs(diff) <= 0.6) {
            idx = goal;
            if (targetIdx >= STOPS.length - 1) { stopPlay(); }
            else { holdUntil = ts + 1000; targetIdx += 1; }
          } else {
            idx = Math.round(idx + Math.sign(diff) * Math.min(Math.abs(diff), 1.1));
          }
        }
      }
      updateBat();
      controls.update();
      renderer.render(scene, camera);

      const stop = STOPS[nearestStop()];
      el.stop.textContent = stop.label;
      el.blurb.textContent = stop.blurb;
      el.progress.style.width = `${(idx / (D.length - 1)) * 100}%`;
      renderCallouts(stop);
      drawOverlay();
    }

    function setT(t) {
      idx = Math.max(0, Math.min(D.length - 1, idxForT(t)));
      for (const s of STOPS) {
        if (Math.abs(T[idx] - s.t) < 22) { idx = idxForT(s.t); break; }
      }
    }

    // ---- controls ----
    el.play.addEventListener('click', () => {
      if (playing) { stopPlay(); return; }
      playing = true; holdUntil = 0; el.play.textContent = '❚❚ Pause';
      let i = STOPS.findIndex((s) => idxForT(s.t) > idx + 1);
      if (i < 0) { idx = idxForT(STOPS[0].t); i = 1; }
      targetIdx = i;
    });
    document.getElementById('bp-prev').addEventListener('click', () => { stopPlay(); setT(STOPS[Math.max(0, nearestStop() - 1)].t); });
    document.getElementById('bp-next').addEventListener('click', () => { stopPlay(); setT(STOPS[Math.min(STOPS.length - 1, nearestStop() + 1)].t); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { stopPlay(); setT(T[idx] + 12); }
      if (e.key === 'ArrowRight') { stopPlay(); setT(T[idx] - 12); }
    });

    STOPS.forEach((s) => {
      const b = document.createElement('button');
      b.className = 'bp-seg';
      b.type = 'button';
      b.dataset.stop = s.key;
      b.innerHTML = `${s.label}${s.ids.length ? '<span class="bp-seg__dot"></span>' : ''}`;
      b.addEventListener('click', () => { stopPlay(); setT(s.t); });
      el.track.appendChild(b);
    });

    // ---- panel ----
    function renderPanel(id) {
      const m = byId(id);
      if (!m) return;
      const levels = m.levels ? `<dt>Levels</dt><dd>${m.levels.map((l) => `${l.label}: ${l.value}`).join('<br>')}</dd>` : '';
      const flags = m.flags.length ? `<dt>Watch for</dt><dd><ul>${m.flags.map((f) => `<li>${f}</li>`).join('')}</ul></dd>` : '';
      const related = m.related.length
        ? `<ul class="bp-related">${m.related.map((r) => `<li><button class="bp-chip" data-metric="${r}" type="button">${byId(r).name}</button></li>`).join('')}</ul>`
        : '';
      el.panelBody.innerHTML = `
        <p class="bp-drawer__phase">${m.key ? '★ Key metric' : 'Supporting metric'}</p>
        <h3>${m.name}${m.unit ? ` <span style="color: var(--muted); font-weight: 400; font-size: 1rem;">${m.unit}</span>` : ''}</h3>
        <dl class="bp-spec">
          <dt>When measured</dt><dd>${m.when}</dd>
          <dt>What it is</dt><dd>${m.definition}</dd>
          <dt>Why it matters</dt><dd>${m.why}</dd>
          <dt>Target</dt><dd><strong>${m.target}</strong></dd>
          ${m.inGym ? `<dt>In-gym pro</dt><dd>${m.inGym}</dd>` : ''}
          ${m.mlb ? `<dt>MLB</dt><dd>${m.mlb}</dd>` : ''}
          ${levels}${flags}
        </dl>
        ${related ? `<p style="font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 1.3rem 0 0;">Related</p>${related}` : ''}
      `;
    }
    function openPanel(id) {
      renderPanel(id);
      el.panel.classList.add('is-open');
      el.panel.setAttribute('aria-hidden', 'false');
      el.scrim.hidden = false;
      requestAnimationFrame(() => el.scrim.classList.add('is-on'));
    }
    function closePanel() {
      el.panel.classList.remove('is-open');
      el.panel.setAttribute('aria-hidden', 'true');
      el.scrim.classList.remove('is-on');
      setTimeout(() => { el.scrim.hidden = true; }, 220);
    }
    document.getElementById('bp-panel-close').addEventListener('click', closePanel);
    el.scrim.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });
    document.addEventListener('click', (e) => {
      const t = e.target.closest('[data-metric]');
      if (t) {
        openPanel(t.dataset.metric);
        document.querySelectorAll('.bp-node').forEach((n) => n.classList.toggle('is-active', n.dataset.metric === t.dataset.metric));
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const n = document.activeElement;
      if (n && n.classList && (n.classList.contains('bp-callout') || n.classList.contains('bp-node'))) {
        e.preventDefault(); openPanel(n.dataset.metric);
      }
    });

    // ---- init ----
    resize();
    const q = new URLSearchParams(location.search).get('checkpoint');
    if (q) {
      const contactIds = ['bat-speed', 'attack-angle', 'vertical-bat-angle', 'connection-at-impact'];
      if (contactIds.includes(q)) idx = idxForT(0);
      else { const s = STOPS.find((x) => x.key === q); if (s) idx = idxForT(s.t); }
    }
    window.addEventListener('resize', resize);
    new ResizeObserver(resize).observe(el.canvas);
    requestAnimationFrame(frame);

    const openId = new URLSearchParams(location.search).get('open');
    if (openId && byId(openId)) openPanel(openId);
  </script>
</Base>

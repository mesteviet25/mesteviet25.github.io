---
import Base from '../../layouts/Base.astro';
import Fractal from '../../components/Fractal.astro';
import { metrics, sourceNote } from '../../data/blastMetrics';
import { planePath, zone, body, VIEW_W, VIEW_H } from '../../lib/swing';

const fullPlane = planePath(0, 360, 4);
const zoneCx = zone.x + zone.w / 2;
const zoneCy = zone.y + zone.h / 2;
---

<Base
  title="Blast Motion Metrics Primer — Stevie Thomas"
  description="An interactive primer on every Blast Motion metric: what it measures, when in the swing it is captured, its target range, and how the metrics feed each other."
>
  <article>
    <header class="bp-hero hero-wrap">
      <Fractal variant="hero" />
      <p class="eyebrow eyebrow--grad reveal" style="--i:0">Resources · Interactive primer</p>
      <h1 class="reveal" style="--i:1">Blast Motion metrics, from the ground up</h1>
      <p class="lede reveal" style="--i:2">
        A bat sensor does not tell you whether a swing is good. It tells you <em>where</em> the bat was
        and <em>how fast</em> at a few specific instants. Below, the swing plane is the ellipse around
        the body that Blast builds backward from the vertical bat angle at contact. Drag the bat
        around it — it pauses at each metric and shows you where that number comes from.
      </p>
    </header>

    <!-- ================= Full-page explorer ================= -->
    <section class="bp-bleed bp-explorer" id="bp-explorer">
      <div class="bp-frame" id="bp-frame">
        <div class="bp-toolbar">
          <div class="bp-toolbar__group">
            <button class="bp-btn" id="bp-prev" type="button" aria-label="Previous checkpoint">‹</button>
            <button class="bp-btn bp-btn--play" id="bp-play" type="button">▶ Swing</button>
            <button class="bp-btn" id="bp-next" type="button" aria-label="Next checkpoint">›</button>
          </div>
          <span class="bp-toolbar__hint">Drag the bat · ← → to nudge</span>
        </div>

        <svg
          id="bp-svg"
          class="bp-svg"
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="An ellipse representing the swing plane around a hitter's body, with a bat that can be dragged around it"
        >
          <defs>
            <linearGradient id="bp-batgrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#6d8dff"></stop>
              <stop offset="1" stop-color="#ff5fa2"></stop>
            </linearGradient>
            <marker id="bp-vel-arrow" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="#ff5fa2"></path>
            </marker>
          </defs>

          <!-- ground shadow -->
          <ellipse cx={body.x} cy={body.y + 212} rx="280" ry="44" fill="var(--accent-a)" opacity="0.05"></ellipse>

          <!-- swing plane -->
          <path d={fullPlane} class="bp-plane" fill="none"></path>

          <!-- strike zone -->
          <g transform={`rotate(${zone.rot} ${zoneCx} ${zoneCy})`}>
            <rect
              x={zone.x}
              y={zone.y}
              width={zone.w}
              height={zone.h}
              fill="var(--accent-a)"
              fill-opacity="0.04"
              stroke="#6d8dff"
              stroke-dasharray="6 6"
              stroke-width="1.4"></rect>
          </g>
          <text x={zoneCx} y={zone.y - 14} text-anchor="middle" class="bp-label">strike zone</text>

          <!-- hitter -->
          <g class="bp-figure" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx={body.x} cy={body.y - 150} r="40" stroke-width="5"></circle>
            <path d={`M${body.x} ${body.y - 105} C${body.x - 30} ${body.y - 40} ${body.x - 32} ${body.y + 8} ${body.x - 10} ${body.y + 64}`} stroke-width="6"></path>
            <path d={`M${body.x - 10} ${body.y + 64} L${body.x - 78} ${body.y + 258}`} stroke-width="7"></path>
            <path d={`M${body.x - 10} ${body.y + 64} L${body.x + 80} ${body.y + 264}`} stroke-width="7"></path>
            <path d={`M${body.x - 16} ${body.y - 92} L${body.x - 46} ${body.y + 14}`} stroke-width="5"></path>
          </g>

          <!-- dynamic scene -->
          <g id="bp-scene"></g>
        </svg>

        <div class="bp-hud">
          <div class="bp-hud__text">
            <span class="bp-hud__stop" id="bp-stop">Load</span>
            <span class="bp-hud__blurb" id="bp-blurb"></span>
          </div>
          <span class="bp-hud__cta" id="bp-cta">Click a box to read more</span>
        </div>
        <div class="bp-progress"><span id="bp-progress-fill"></span></div>
      </div>
    </section>

    <p class="bp-note-line">
      The explorer is a teaching drawing: the geometry is illustrative, not a physical simulation.
      The target ranges and benchmarks are the real ones.
    </p>

    <!-- ================= Relationship map ================= -->
    <section style="margin-top: clamp(3rem, 8vw, 4.5rem);">
      <p class="section-label">How the metrics feed each other</p>
      <h2>The chain is the story</h2>
      <p style="max-width: 58ch; color: var(--muted);">
        Blast metrics are not a checklist. Connection at the start of the downswing sets up
        connection at impact, which sets up on-plane efficiency. Bat speed is built upstream by
        rotational acceleration and the hands. Click a node to open it.
      </p>

      <div class="bp-map-wrap">
        <svg class="bp-map" viewBox="0 0 900 500" role="img" aria-label="Relationship map of Blast metrics">
          <defs>
            <marker id="bp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor"></path>
            </marker>
          </defs>

          {[
            { id: 'early-connection', x: 40, y: 60 },
            { id: 'rotational-acceleration', x: 40, y: 185 },
            { id: 'peak-hand-speed', x: 40, y: 310 },
            { id: 'time-to-contact', x: 40, y: 435 },
            { id: 'connection-at-impact', x: 355, y: 60 },
            { id: 'bat-speed', x: 355, y: 250 },
            { id: 'on-plane-efficiency', x: 670, y: 60 },
            { id: 'power', x: 670, y: 250 },
          ].map((n) => {
            const m = metrics.find((x) => x.id === n.id)!;
            return (
              <g class="bp-node" data-metric={n.id} tabindex="0" role="button" aria-label={m.name} transform={`translate(${n.x},${n.y})`}>
                <rect width="190" height="46" rx="3"></rect>
                <text x="14" y="28" fill="currentColor">{m.name}</text>
              </g>
            );
          })}

          <path class="bp-edge bp-edge--chain" d="M230 83 L355 83"></path>
          <path class="bp-edge bp-edge--chain" d="M545 83 L670 83"></path>
          <path class="bp-edge" d="M230 208 L355 268"></path>
          <path class="bp-edge" d="M230 333 L355 288"></path>
          <path class="bp-edge" d="M230 458 L355 285"></path>
          <path class="bp-edge" d="M545 273 L670 273"></path>

          <text class="bp-edge-label" x="235" y="74">sets up</text>
          <text class="bp-edge-label" x="550" y="74">downstream of both</text>
          <text class="bp-edge-label" x="238" y="196">builds</text>
          <text class="bp-edge-label" x="238" y="348">builds</text>
          <text class="bp-edge-label" x="238" y="452">longer = less</text>
          <text class="bp-edge-label" x="560" y="264">derives</text>
        </svg>
      </div>
    </section>

    <!-- ================= Reference tables ================= -->
    <section class="bp-tables">
      <p class="section-label">Reference</p>
      <h2>Target ranges at a glance</h2>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>When</th>
            <th>Target</th>
          </tr>
        </thead>
        <tbody>
          {
            metrics.map((m) => (
              <tr>
                <td>
                  {m.key && <span class="bp-flag">★ </span>}
                  {m.name}
                </td>
                <td style="color: var(--muted);">{m.when}</td>
                <td>{m.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 style="margin-top: 2.6rem;">Level benchmarks</h2>
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>Bat speed (mean)</th>
            <th>Rotational acceleration</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>MLB</td><td>~75+ mph</td><td>~17 g</td></tr>
          <tr><td>NPB</td><td>~70–75 mph</td><td>~13–16 g</td></tr>
          <tr><td>MiLB</td><td>~72–76 mph</td><td>~14–17 g</td></tr>
          <tr><td>College</td><td>~68–74 mph</td><td>~12–13 g</td></tr>
          <tr><td>High school</td><td>~60–66 mph</td><td>&lt; 10 g</td></tr>
        </tbody>
      </table>
      <p style="color: var(--muted); font-size: 0.84rem; margin-top: 0.8rem;">
        Directional. Driveline models level-specific regressions; confirm the athlete's level before
        grading against any number here.
      </p>
    </section>

    <p class="bp-source">{sourceNote}</p>
  </article>

  <!-- ================= Slide-over panel ================= -->
  <div class="bp-scrim" id="bp-scrim" hidden></div>
  <aside class="bp-panel" id="bp-panel" aria-hidden="true" aria-label="Metric detail">
    <button class="bp-panel__close" id="bp-panel-close" type="button" aria-label="Close">×</button>
    <div id="bp-panel-body"></div>
  </aside>

  <script>
    import { metrics } from '../../data/blastMetrics';
    import {
      STOPS,
      PHI_LOAD,
      PHI_FINISH,
      CX,
      CY,
      A,
      B,
      TILT,
      barrelPoint,
      handsPoint,
      pointAlongBat,
      planePath,
      batPolygon,
      anchorPoint,
      CALLOUT_LAYOUT,
      CALLOUT_W,
      CALLOUT_H,
      VIEW_W,
      VIEW_H,
    } from '../../lib/swing';

    const byId = (id) => metrics.find((m) => m.id === id);
    const NS = 'http://www.w3.org/2000/svg';

    const svg = document.getElementById('bp-svg');
    const scene = document.getElementById('bp-scene');
    const stopEl = document.getElementById('bp-stop');
    const blurbEl = document.getElementById('bp-blurb');
    const progressFill = document.getElementById('bp-progress-fill');
    const playBtn = document.getElementById('bp-play');
    const panel = document.getElementById('bp-panel');
    const panelBody = document.getElementById('bp-panel-body');
    const scrim = document.getElementById('bp-scrim');

    let phi = STOPS[1].phi; // open on the first real metric checkpoint

    function el(tag, attrs = {}) {
      const n = document.createElementNS(NS, tag);
      for (const k in attrs) n.setAttribute(k, attrs[k]);
      return n;
    }

    function nearestStop(p) {
      let best = 0;
      let bd = Infinity;
      STOPS.forEach((s, i) => {
        const d = Math.abs(s.phi - p);
        if (d < bd) {
          bd = d;
          best = i;
        }
      });
      return best;
    }

    function makeCallout(metricId, stop, currentPhi) {
      const m = byId(metricId);
      const spec = CALLOUT_LAYOUT[metricId];
      if (!m || !spec) return;
      const anchor = anchorPoint(spec.anchor, currentPhi, stop.segment);
      let bx = anchor.x + spec.dx;
      let by = anchor.y + spec.dy;
      bx = Math.max(18, Math.min(VIEW_W - CALLOUT_W - 18, bx));
      by = Math.max(18, Math.min(VIEW_H - CALLOUT_H - 18, by));
      const cx = bx + CALLOUT_W / 2;
      const cy = by + CALLOUT_H / 2;

      const g = el('g', { class: 'bp-callout', 'data-metric': metricId, tabindex: '0', role: 'button' });

      // leader line + anchor dot
      g.appendChild(el('line', { x1: anchor.x, y1: anchor.y, x2: cx, y2: cy, class: 'bp-leader-line' }));
      g.appendChild(el('circle', { cx: anchor.x, cy: anchor.y, r: 4, class: 'bp-anchor-dot' }));

      g.appendChild(el('rect', { x: bx, y: by, width: CALLOUT_W, height: CALLOUT_H, rx: 6, class: 'bp-callout-box' }));
      g.appendChild(el('rect', { x: bx, y: by + 8, width: 3, height: CALLOUT_H - 16, rx: 1.5, class: 'bp-callout-bar' }));

      const title = el('text', { x: bx + 16, y: by + 23, class: 'bp-callout-title' });
      title.textContent = (m.key ? '★ ' : '') + m.name;
      g.appendChild(title);

      const sub = el('text', { x: bx + 16, y: by + 40, class: 'bp-callout-sub' });
      sub.textContent = m.unit ? `${stop.label} · ${m.unit}` : stop.label;
      g.appendChild(sub);

      scene.appendChild(g);
    }

    function render(p) {
      scene.textContent = '';
      const stopIdx = nearestStop(p);
      const stop = STOPS[stopIdx];

      // on-plane / rotational-acceleration windows (faint, brightened when active)
      STOPS.forEach((s) => {
        if (!s.segment) return;
        const active = s === stop;
        scene.appendChild(
          el('path', {
            d: planePath(s.segment[0], s.segment[1], 3),
            class: active ? 'bp-window bp-window--active' : 'bp-window',
            fill: 'none',
          })
        );
      });

      // traveled arc
      if (p > PHI_LOAD + 2) {
        scene.appendChild(el('path', { d: planePath(PHI_LOAD, p, 3), class: 'bp-trail', fill: 'none' }));
      }

      // time-to-contact bracket across the downswing
      if (stopIdx >= 1 && stopIdx <= 5) {
        const b = el('path', {
          d: ellipseArc(212, 318, 0.84),
          class: 'bp-ttc',
          fill: 'none',
        });
        scene.appendChild(b);
        const mid = barrelPoint(265);
        const t = el('text', { x: mid.x - 150, y: mid.y + 92, class: 'bp-ttc-label' });
        t.textContent = 'Time to Contact';
        scene.appendChild(t);
      }

      // bat
      const bat = el('polygon', { points: batPolygon(p), class: 'bp-bat' });
      scene.appendChild(bat);
      const h = handsPoint(p);
      scene.appendChild(el('circle', { cx: h.x, cy: h.y, r: 7, class: 'bp-knob' }));

      // sweet spot
      const sweet = pointAlongBat(p, 0.74);
      scene.appendChild(el('circle', { cx: sweet.x, cy: sweet.y, r: 5.5, class: 'bp-sweet' }));

      // velocity (attack-angle) arrow
      const brl = barrelPoint(p);
      const ang = 12 * (Math.PI / 180);
      scene.appendChild(
        el('line', {
          x1: brl.x,
          y1: brl.y,
          x2: brl.x + 120 * Math.cos(ang),
          y2: brl.y - 120 * Math.sin(ang),
          class: 'bp-vel',
          'marker-end': 'url(#bp-vel-arrow)',
        })
      );
      const vlabel = el('text', { x: brl.x + 128, y: brl.y - 42, class: 'bp-vel-label' });
      vlabel.textContent = 'attack angle';
      scene.appendChild(vlabel);

      // callouts
      stop.metricIds.forEach((id) => makeCallout(id, stop, p));

      // hud
      stopEl.textContent = stop.label;
      blurbEl.textContent = stop.blurb;
      progressFill.style.width = `${(((p - PHI_LOAD) / (PHI_FINISH - PHI_LOAD)) * 100).toFixed(1)}%`;
      document.querySelectorAll('.bp-node').forEach((n) => n.classList.remove('is-active'));
    }

    function ellipseArc(phi0, phi1, scale) {
      const step = 3;
      const dir = phi1 >= phi0 ? 1 : -1;
      const pts = [];
      for (let p = phi0; dir > 0 ? p <= phi1 : p >= phi1; p += dir * step) {
        const t = p * (Math.PI / 180);
        const rot = (x, y) => {
          const c = Math.cos((TILT * Math.PI) / 180);
          const s = Math.sin((TILT * Math.PI) / 180);
          return { x: x * c - y * s, y: x * s + y * c };
        };
        const q = rot(A * scale * Math.cos(t), B * scale * Math.sin(t));
        pts.push(`${(CX + q.x).toFixed(1)},${(CY - q.y).toFixed(1)}`);
      }
      return 'M' + pts.join(' L');
    }

    function setPhi(p, snap = true) {
      phi = Math.max(PHI_LOAD, Math.min(PHI_FINISH, p));
      if (snap) {
        for (const s of STOPS) {
          if (Math.abs(s.phi - phi) < 6) {
            phi = s.phi;
            break;
          }
        }
      }
      render(phi);
    }

    // ---- drag ----
    function pointerToPhi(evt) {
      const ctm = svg.getScreenCTM().inverse();
      const scr = new DOMPoint(evt.clientX, evt.clientY).matrixTransform(ctm);
      const dx = scr.x - CX;
      const dy = -(scr.y - CY);
      const c = Math.cos((-TILT * Math.PI) / 180);
      const s = Math.sin((-TILT * Math.PI) / 180);
      const x = dx * c - dy * s;
      const y = dx * s + dy * c;
      let p = (Math.atan2(y / B, x / A) * 180) / Math.PI;
      while (p < PHI_LOAD - 70) p += 360;
      while (p > PHI_FINISH + 70) p -= 360;
      return p;
    }

    let dragging = false;
    svg.style.cursor = 'grab';
    svg.addEventListener('pointerdown', (e) => {
      // let callout boxes be clicked without starting a drag
      if (e.target.closest && e.target.closest('.bp-callout')) return;
      dragging = true;
      stopPlay();
      svg.setPointerCapture(e.pointerId);
      svg.style.cursor = 'grabbing';
      setPhi(pointerToPhi(e));
    });
    svg.addEventListener('pointermove', (e) => {
      if (dragging) setPhi(pointerToPhi(e));
    });
    const endDrag = (e) => {
      if (!dragging) return;
      dragging = false;
      svg.style.cursor = 'grab';
      try {
        svg.releasePointerCapture(e.pointerId);
      } catch (err) {
        /* already released */
      }
    };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        stopPlay();
        setPhi(phi + 4);
      }
      if (e.key === 'ArrowRight') {
        stopPlay();
        setPhi(phi - 4);
      }
    });

    // ---- autoplay ----
    let playing = false;
    let raf = null;
    let targetIdx = 0;
    let holdUntil = 0;

    function stopPlay() {
      playing = false;
      if (raf) cancelAnimationFrame(raf);
      raf = null;
      playBtn.textContent = '▶ Swing';
    }

    function tick(ts) {
      if (!playing) return;
      if (holdUntil && ts < holdUntil) {
        raf = requestAnimationFrame(tick);
        return;
      }
      const goal = STOPS[targetIdx].phi;
      const diff = goal - phi;
      if (Math.abs(diff) <= 1.5) {
        setPhi(goal);
        if (targetIdx >= STOPS.length - 1) {
          stopPlay();
          return;
        }
        holdUntil = ts + 1050;
        targetIdx += 1;
      } else {
        setPhi(phi + Math.sign(diff) * Math.min(Math.abs(diff), 2.4));
      }
      raf = requestAnimationFrame(tick);
    }

    playBtn.addEventListener('click', () => {
      if (playing) {
        stopPlay();
        return;
      }
      playing = true;
      holdUntil = 0;
      playBtn.textContent = '❚❚ Pause';
      let idx = STOPS.findIndex((s) => s.phi > phi + 2);
      if (idx < 0) {
        setPhi(STOPS[0].phi);
        idx = 1;
      }
      targetIdx = idx;
      raf = requestAnimationFrame(tick);
    });

    document.getElementById('bp-prev').addEventListener('click', () => {
      stopPlay();
      const idx = nearestStop(phi) - 1;
      setPhi(STOPS[Math.max(0, idx)].phi);
    });
    document.getElementById('bp-next').addEventListener('click', () => {
      stopPlay();
      const idx = nearestStop(phi) + 1;
      setPhi(STOPS[Math.min(STOPS.length - 1, idx)].phi);
    });

    // ---- slide-over panel ----
    function renderPanel(id) {
      const m = byId(id);
      if (!m) return;
      const levels = m.levels
        ? `<dt>Levels</dt><dd>${m.levels.map((l) => `${l.label}: ${l.value}`).join('<br>')}</dd>`
        : '';
      const flags = m.flags.length
        ? `<dt>Watch for</dt><dd><ul>${m.flags.map((f) => `<li>${f}</li>`).join('')}</ul></dd>`
        : '';
      const related = m.related.length
        ? `<ul class="bp-related">${m.related
            .map((r) => `<li><button class="bp-chip" data-metric="${r}" type="button">${byId(r).name}</button></li>`)
            .join('')}</ul>`
        : '';

      panelBody.innerHTML = `
        <p class="bp-drawer__phase">${m.key ? '★ Key metric' : 'Supporting metric'}</p>
        <h3>${m.name}${m.unit ? ` <span style="color: var(--muted); font-weight: 400; font-size: 1rem;">${m.unit}</span>` : ''}</h3>
        <dl class="bp-spec">
          <dt>When measured</dt><dd>${m.when}</dd>
          <dt>What it is</dt><dd>${m.definition}</dd>
          <dt>Why it matters</dt><dd>${m.why}</dd>
          <dt>Target</dt><dd><strong>${m.target}</strong></dd>
          ${m.inGym ? `<dt>In-gym pro</dt><dd>${m.inGym}</dd>` : ''}
          ${m.mlb ? `<dt>MLB</dt><dd>${m.mlb}</dd>` : ''}
          ${levels}
          ${flags}
        </dl>
        ${related ? `<p style="font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 1.3rem 0 0;">Related</p>${related}` : ''}
      `;
    }

    function openPanel(id) {
      renderPanel(id);
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      scrim.hidden = false;
      requestAnimationFrame(() => scrim.classList.add('is-on'));
    }
    function closePanel() {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      scrim.classList.remove('is-on');
      setTimeout(() => {
        scrim.hidden = true;
      }, 220);
    }

    document.getElementById('bp-panel-close').addEventListener('click', closePanel);
    scrim.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });

    document.addEventListener('click', (e) => {
      const t = e.target.closest('[data-metric]');
      if (t) {
        // don't open from inside the already-open panel's related list unless it's a related chip
        openPanel(t.getAttribute('data-metric'));
        document.querySelectorAll('.bp-node').forEach((n) => {
          n.classList.toggle('is-active', n.getAttribute('data-metric') === t.getAttribute('data-metric'));
        });
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const n = document.activeElement;
      if (n && n.classList && (n.classList.contains('bp-callout') || n.classList.contains('bp-node'))) {
        e.preventDefault();
        openPanel(n.getAttribute('data-metric'));
      }
    });

    // ---- init ----
    const startPhi = (() => {
      const q = new URLSearchParams(location.search).get('checkpoint');
      if (!q) return STOPS[1].phi;
      if (q === 'bat-speed' || q === 'attack-angle' || q === 'vertical-bat-angle' || q === 'connection-at-impact') return 318;
      const s = STOPS.find((x) => x.key === q);
      return s ? s.phi : STOPS[1].phi;
    })();
    setPhi(startPhi, false);
    render(phi);

    const openId = new URLSearchParams(location.search).get('open');
    if (openId && byId(openId)) openPanel(openId);
  </script>
</Base>

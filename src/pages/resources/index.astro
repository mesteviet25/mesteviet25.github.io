---
import Base from '../../layouts/Base.astro';
import { resources } from '../../data/resources';
---

<Base
  title="Resources — Stevie Thomas"
  description="Free, technical coaching resources on hitting: bat tracking, swing mechanics, and how to read the numbers."
>
  <section style="padding: clamp(2.5rem, 7vw, 4.5rem) 0 0;">
    <p class="eyebrow reveal" style="--i:0">Resources</p>
    <h1 class="reveal" style="--i:1">Coaching resources</h1>
  </section>

  <div style="margin-top: clamp(2rem, 6vw, 3rem);">
    {
      resources.map((r) => (
        <a class="viewer-card reveal" href={r.href ?? `/resources/${r.slug}/`}>
          {r.preview && (
            <span class="viewer-card__shot">
              <img src={r.preview} alt={`${r.title} preview`} loading="lazy" />
            </span>
          )}
          <span class="viewer-card__body">
            <span class="viewer-card__kind">{r.kind}</span>
            <h2>{r.title}</h2>
            <p>{r.summary}</p>
            <ul class="res-card__tags">
              {r.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </span>
        </a>
      ))
    }
  </div>
</Base>
